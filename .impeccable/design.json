      "css": ".ds-index{font-family:var(--font-ui,\"Atkinson Hyperlegible\",\"Segoe UI\",sans-serif);display:flex;align-items:center;justify-content:space-between;gap:20px;width:100%;min-height:74px;padding:17px 0;color:var(--ink,#302a21);background:transparent;border:0;border-top:1px solid var(--line,#d6c9af);border-bottom:1px solid var(--line,#d6c9af);text-align:left;cursor:pointer}.ds-index:hover{color:var(--green,#3e5944);background:#f0e8d7}.ds-index:focus-visible{outline:3px solid var(--focus,#31573a);outline-offset:4px}.ds-index-title{display:block;font-size:18px;font-weight:600;line-height:1.35}.ds-index-meta{display:block;margin-top:5px;color:var(--muted,#746651);font-size:13px;font-weight:400;line-height:1.55}.ds-index svg{width:22px;height:22px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.6}"
