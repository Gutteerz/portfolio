      "css": ".ds-nav{display:inline-flex;align-items:center;padding:0 4px;background:rgba(243,234,216,.95);border-radius:6px}.ds-nav a,.ds-nav button{font-family:var(--font-ui,\"Atkinson Hyperlegible\",\"Segoe UI\",sans-serif);display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:8px 12px;color:var(--ink,#302a21);background:transparent;border:0;text-decoration:none;font-size:14px;line-height:1.55;border-radius:4px;cursor:pointer}.ds-nav a:hover,.ds-nav button:hover{background:#e7dcc6}.ds-nav a:focus-visible,.ds-nav button:focus-visible{outline:3px solid var(--focus,#31573a);outline-offset:4px}.ds-nav .ds-icon{padding:10px}.ds-nav svg{width:22px;height:22px;display:block}"
    },
