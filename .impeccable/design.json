      "html": "<section class=\"ds-panel\" aria-label=\"Project panel preview\"><header class=\"ds-panel-header\"><h2>Projects</h2><button class=\"ds-close\" type=\"button\" aria-label=\"Close project index\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button></header><p>Explore the projects from the workshop.</p></section>",
      "css": ".ds-panel{font-family:var(--font-ui,\"Atkinson Hyperlegible\",\"Segoe UI\",sans-serif);width:min(640px,calc(100vw - 40px));max-height:min(820px,calc(100dvh - 72px));padding:30px 32px;overflow:auto;color:var(--ink,#302a21);background:var(--paper-light,#fbf6ea);border:0;border-radius:12px;box-shadow:var(--panel-shadow,0 18px 64px rgba(43,34,21,.25));font-size:16px;line-height:1.55}.ds-panel-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px}.ds-panel h2{font-size:28px;font-weight:600;line-height:1.2;margin:0;padding-top:7px}.ds-panel p{margin:0}.ds-close{display:grid;place-items:center;width:44px;height:44px;flex:0 0 44px;margin:-3px -8px 0 0;padding:10px;background:transparent;border:0;border-radius:6px;cursor:pointer;color:inherit}.ds-close:hover{background:#e9dfcd}.ds-close:focus-visible{outline:3px solid var(--focus,#31573a);outline-offset:4px}.ds-close svg{width:22px;height:22px}@media(max-width:640px){.ds-panel{width:calc(100vw - 24px);max-height:calc(100dvh - 32px);padding:22px;border-radius:10px}.ds-panel h2{font-size:25px}}"
    },
